#!/usr/bin/env bash

# claude-statusline: Shows Claude Code usage in the statusline
# This script receives JSON from Claude Code as first argument ($1)
# Caches API responses to avoid hammering the endpoint on every update

set -euo pipefail

# Read JSON from first argument or stdin (Claude Code sends session info including context window)
# Try both sources to see which one works
if [[ -n "${1:-}" ]] && [[ "$1" != "{}" ]]; then
    INPUT="$1"
else
    # Try stdin with timeout
    INPUT=$(timeout 0.1 cat 2>/dev/null || echo "{}")
fi

CACHE_FILE="/tmp/claude-usage-cache"
CACHE_MAX_AGE=30 # seconds - usage data doesn't change that fast

# Check if cache is fresh enough
cache_is_fresh() {
    if [[ ! -f "$CACHE_FILE" ]]; then
        return 1
    fi

    local now=$(date +%s)
    # BSD stat (macOS) uses -f %m, GNU stat (Linux) uses -c %Y
    local mtime
    if stat -f %m "$CACHE_FILE" >/dev/null 2>&1; then
        # macOS
        mtime=$(stat -f %m "$CACHE_FILE")
    else
        # Linux
        mtime=$(stat -c %Y "$CACHE_FILE")
    fi
    local age=$((now - mtime))

    [[ $age -lt $CACHE_MAX_AGE ]]
}

# Portable credential chain - try all sources in priority order
get_oauth_token() {
    local token=""

    # 1. Environment variable (explicit override)
    if [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
        token="$CLAUDE_CODE_OAUTH_TOKEN"
        echo "$token"
        return 0
    fi

    # 2. Credentials file (Linux/devcontainers)
    if [[ -f "$HOME/.claude/.credentials.json" ]]; then
        token=$(jq -r '.claudeAiOauth.accessToken // empty' "$HOME/.claude/.credentials.json" 2>/dev/null || echo "")
        if [[ -n "$token" ]]; then
            echo "$token"
            return 0
        fi
    fi

    # 3. macOS Keychain (fallback)
    if command -v security >/dev/null 2>&1; then
        token=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null \
            | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null || echo "")
        if [[ -n "$token" ]]; then
            echo "$token"
            return 0
        fi
    fi

    # No token found
    return 1
}

# Try to get usage data from API (skip if no token)
USAGE="{}"
if cache_is_fresh; then
    USAGE=$(cat "$CACHE_FILE")
else
    # Try to get OAuth token
    TOKEN=$(get_oauth_token || echo "")

    if [[ -n "$TOKEN" ]]; then
        # Query usage API
        USAGE=$(curl -s --connect-timeout 3 --max-time 5 \
            "https://api.anthropic.com/api/oauth/usage" \
            -H "Authorization: Bearer $TOKEN" \
            -H "anthropic-beta: oauth-2025-04-20" \
            -H "Content-Type: application/json" 2>/dev/null || echo "{}")

        # Only cache valid responses
        if echo "$USAGE" | jq -e '.five_hour' >/dev/null 2>&1; then
            echo "$USAGE" > "$CACHE_FILE"
        elif [[ -f "$CACHE_FILE" ]]; then
            # Fall back to stale cache on API error
            USAGE=$(cat "$CACHE_FILE")
        fi
    fi
    # If no token, USAGE remains "{}" and we skip quota display
fi

# Parse usage data
FIVE_HOUR=$(echo "$USAGE" | jq -r '.five_hour.utilization // "?" | floor' 2>/dev/null)
FIVE_RESET=$(echo "$USAGE" | jq -r '.five_hour.resets_at // ""' 2>/dev/null)
SEVEN_DAY=$(echo "$USAGE" | jq -r '.seven_day.utilization // "?" | floor' 2>/dev/null)
SEVEN_RESET=$(echo "$USAGE" | jq -r '.seven_day.resets_at // ""' 2>/dev/null)
SONNET=$(echo "$USAGE" | jq -r '.seven_day_sonnet.utilization // null | if . != null then floor else null end' 2>/dev/null)
OPUS=$(echo "$USAGE" | jq -r '.seven_day_opus.utilization // null | if . != null then floor else null end' 2>/dev/null)
EXTRA_ENABLED=$(echo "$USAGE" | jq -r '.extra_usage.is_enabled // false' 2>/dev/null)
EXTRA_USED=$(echo "$USAGE" | jq -r '.extra_usage.used_credits // 0 | floor / 100' 2>/dev/null)
EXTRA_LIMIT=$(echo "$USAGE" | jq -r '.extra_usage.monthly_limit // 0 | floor / 100' 2>/dev/null)

# Calculate per-model contribution to 7-day total based on token usage
# Try Firebase first (cross-machine, 7-day windowed), fall back to local dailyModelTokens
HAIKU_TOKENS=0
SONNET_TOKENS=0
OPUS_TOKENS=0

if [[ "$SEVEN_DAY" != "?" ]] && [[ "$SONNET" != "null" ]]; then
    # Try Firebase first
    if [[ -n "${CLAUDE_FIREBASE_URL:-}" ]] && command -v claude-session-sync >/dev/null 2>&1; then
        TOKEN_DATA=$(claude-session-sync token-read --days 7 2>/dev/null || echo "{}")

        if [[ "$TOKEN_DATA" != "{}" ]]; then
            # Use regex matching for model IDs to be resilient to version changes
            HAIKU_TOKENS=$(echo "$TOKEN_DATA" | jq -r 'to_entries | map(select(.key | test("haiku"))) | map(.value) | add // 0' 2>/dev/null || echo 0)
            SONNET_TOKENS=$(echo "$TOKEN_DATA" | jq -r 'to_entries | map(select(.key | test("sonnet"))) | map(.value) | add // 0' 2>/dev/null || echo 0)
            OPUS_TOKENS=$(echo "$TOKEN_DATA" | jq -r 'to_entries | map(select(.key | test("opus"))) | map(.value) | add // 0' 2>/dev/null || echo 0)
        fi
    fi

    # Fallback to local dailyModelTokens (7-day windowed, still better than all-time)
    if [[ $HAIKU_TOKENS -eq 0 ]] && [[ $SONNET_TOKENS -eq 0 ]] && [[ $OPUS_TOKENS -eq 0 ]]; then
        STATS_FILE="$HOME/.claude/stats-cache.json"
        if [[ -f "$STATS_FILE" ]]; then
            # Calculate cutoff date (7 days ago)
            cutoff_date=""
            if date -v-7d +%Y-%m-%d >/dev/null 2>&1; then
                cutoff_date=$(date -v-7d +%Y-%m-%d)
            else
                cutoff_date=$(date -d "7 days ago" +%Y-%m-%d)
            fi

            # Aggregate tokens from dailyModelTokens for last 7 days (array structure)
            daily_data=$(jq --arg cutoff "$cutoff_date" '
                .dailyModelTokens // [] |
                map(select(.date >= $cutoff)) |
                map(.tokensByModel // {}) |
                reduce .[] as $day ({}; . as $acc | $day | to_entries | reduce .[] as $model ($acc; .[$model.key] += $model.value))
            ' "$STATS_FILE" 2>/dev/null || echo "{}")

            if [[ "$daily_data" != "{}" ]]; then
                HAIKU_TOKENS=$(echo "$daily_data" | jq -r 'to_entries | map(select(.key | test("haiku"))) | map(.value) | add // 0' 2>/dev/null || echo 0)
                SONNET_TOKENS=$(echo "$daily_data" | jq -r 'to_entries | map(select(.key | test("sonnet"))) | map(.value) | add // 0' 2>/dev/null || echo 0)
                OPUS_TOKENS=$(echo "$daily_data" | jq -r 'to_entries | map(select(.key | test("opus"))) | map(.value) | add // 0' 2>/dev/null || echo 0)
            fi
        fi
    fi

    # Calculate per-model contributions using residual-based approach
    # Known: Sonnet from API (if available)
    # Unknown residual: 7d% - Sonnet% = distributed among Opus/Haiku by token ratio
    TOTAL_TOKENS=$((HAIKU_TOKENS + SONNET_TOKENS + OPUS_TOKENS))
    if [[ $TOTAL_TOKENS -gt 0 ]]; then
        # Calculate residual (portion not accounted for by API values)
        RESIDUAL=$SEVEN_DAY
        if [[ "$SONNET" != "null" ]] && [[ "$SONNET" != "?" ]]; then
            RESIDUAL=$(awk "BEGIN {printf \"%.2f\", $SEVEN_DAY - $SONNET}")
        fi

        # Distribute residual among non-Sonnet models by token ratio
        NON_SONNET_TOKENS=$((HAIKU_TOKENS + OPUS_TOKENS))
        if [[ $NON_SONNET_TOKENS -gt 0 ]]; then
            HAIKU=$(awk "BEGIN {printf \"%.2f\", ($HAIKU_TOKENS / $NON_SONNET_TOKENS) * $RESIDUAL}")
            OPUS=$(awk "BEGIN {printf \"%.2f\", ($OPUS_TOKENS / $NON_SONNET_TOKENS) * $RESIDUAL}")
        else
            HAIKU="0"
            OPUS="0"
        fi
    fi
fi

# Match active model ID to token count for display
ACTIVE_MODEL_TOKENS=0
MODEL_ID=$(echo "$INPUT" | jq -r '.model.id // ""' 2>/dev/null || echo "")
if [[ -n "$MODEL_ID" ]]; then
    if [[ "$MODEL_ID" =~ haiku ]]; then
        ACTIVE_MODEL_TOKENS=$HAIKU_TOKENS
    elif [[ "$MODEL_ID" =~ sonnet ]]; then
        ACTIVE_MODEL_TOKENS=$SONNET_TOKENS
    elif [[ "$MODEL_ID" =~ opus ]]; then
        ACTIVE_MODEL_TOKENS=$OPUS_TOKENS
    fi
fi

# Format compact time until reset (with color)
time_until() {
    local reset_time=$1
    if [[ -z "$reset_time" ]] || [[ "$reset_time" == "null" ]]; then
        echo ""
        return
    fi

    local now=$(date -u +%s)
    # Try GNU date first (Homebrew bash), fallback to BSD date (macOS default)
    local reset=$(date -u -d "$reset_time" +%s 2>/dev/null || date -j -u -f "%Y-%m-%dT%H:%M:%S" "$(echo $reset_time | cut -d. -f1)" +%s 2>/dev/null || echo "$now")
    local diff=$((reset - now))

    local time_str
    if [[ $diff -le 0 ]]; then
        time_str="now"
    elif [[ $diff -lt 60 ]]; then
        time_str="${diff}s"
    elif [[ $diff -lt 3600 ]]; then
        time_str="$((diff / 60))m"
    elif [[ $diff -lt 86400 ]]; then
        local h=$((diff / 3600))
        local m=$((diff % 3600 / 60))
        if [[ $m -eq 0 ]]; then
            time_str="${h}h"
        else
            time_str="${h}h${m}m"
        fi
    else
        local d=$((diff / 86400))
        local h=$((diff % 86400 / 3600))
        if [[ $h -eq 0 ]]; then
            time_str="${d}d"
        else
            time_str="${d}d${h}h"
        fi
    fi

    echo "${CYAN}${time_str}${RESET}"
}

# ANSI color codes
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RED=$'\033[31m'
CYAN=$'\033[36m'              # For time periods
BRIGHT_BLUE=$'\033[38;5;33m'  # For synthetic percentages (neutral/informational)
BRIGHT_CYAN=$'\033[38;5;51m'  # For context percentage
LIGHT_PURPLE=$'\033[38;5;141m' # For session cost (interesting metric)
DIM=$'\033[2m'                # For separators
RESET=$'\033[0m'

# Color a dollar amount based on overage limit
# Use same thresholds as percentages: 70% and 90% of limit
color_cost() {
    local cost=$1
    local limit=${2:-50}  # Default to $50 if not provided
    local yellow_threshold=$(awk "BEGIN {printf \"%.0f\", $limit * 0.7}")
    local red_threshold=$(awk "BEGIN {printf \"%.0f\", $limit * 0.9}")

    if (( $(awk "BEGIN {print ($cost >= $red_threshold)}") )); then
        echo "${RED}\$${cost}${RESET}"
    elif (( $(awk "BEGIN {print ($cost >= $yellow_threshold)}") )); then
        echo "${YELLOW}\$${cost}${RESET}"
    else
        echo "${GREEN}\$${cost}${RESET}"
    fi
}

# Color coding based on utilization
# Formats as integer if .00, otherwise shows decimals
color_usage() {
    local val=$1
    if [[ "$val" == "?" ]] || [[ "$val" == "null" ]]; then
        echo "?"
    else
        # Check if decimal part is .00
        local int_part=$(awk "BEGIN {printf \"%.0f\", $val}")
        local decimal_check=$(awk "BEGIN {if ($val == int($val)) print \"true\"; else print \"false\"}")

        local formatted_val
        if [[ "$decimal_check" == "true" ]]; then
            formatted_val="${int_part}%"
        else
            formatted_val="${val}%"
        fi

        if (( $(awk "BEGIN {print ($val >= 90)}") )); then
            echo "${RED}${formatted_val}${RESET}"
        elif (( $(awk "BEGIN {print ($val >= 70)}") )); then
            echo "${YELLOW}${formatted_val}${RESET}"
        else
            echo "${GREEN}${formatted_val}${RESET}"
        fi
    fi
}

# Color coding for synthetic/calculated percentages (always bright blue, no heatmap)
# These are contributions to the total, not separate quotas
# Formats as integer if .00, otherwise shows decimals
color_usage_synthetic() {
    local val=$1
    if [[ "$val" == "?" ]] || [[ "$val" == "null" ]]; then
        echo "?"
    else
        # Check if decimal part is .00
        local int_part=$(awk "BEGIN {printf \"%.0f\", $val}")
        local decimal_check=$(awk "BEGIN {if ($val == int($val)) print \"true\"; else print \"false\"}")

        if [[ "$decimal_check" == "true" ]]; then
            echo "${BRIGHT_BLUE}${int_part}%${RESET}"
        else
            echo "${BRIGHT_BLUE}${val}%${RESET}"
        fi
    fi
}

# Format token count as human-readable
format_tokens() {
    local tokens=$1
    if [[ $tokens -ge 1000000 ]]; then
        awk "BEGIN {printf \"%.1fM\", $tokens / 1000000}"
    elif [[ $tokens -ge 1000 ]]; then
        awk "BEGIN {printf \"%.0fK\", $tokens / 1000}"
    else
        echo "$tokens"
    fi
}

# Calculate time strings
FIVE_TIME=$(time_until "$FIVE_RESET")
SEVEN_TIME=$(time_until "$SEVEN_RESET")

# Dim separators and operators
SEP="${DIM}|${RESET}"
COLON="${DIM}:${RESET}"
EQUALS="${DIM}=${RESET}"
PLUS="${DIM}+${RESET}"

# Build output - start with usage if available
OUTPUT=""

# Only show quota if we have data
if [[ "$FIVE_HOUR" != "?" ]] || [[ "$SEVEN_DAY" != "?" ]]; then
    # Format output with times
    OUTPUT="5h${COLON}$(color_usage $FIVE_HOUR)"
    if [[ -n "$FIVE_TIME" ]]; then
        OUTPUT="${OUTPUT}~${FIVE_TIME}"
    fi

    OUTPUT="${OUTPUT} ${SEP} 7d${COLON}$(color_usage $SEVEN_DAY)"
    if [[ -n "$SEVEN_TIME" ]]; then
        OUTPUT="${OUTPUT}~${SEVEN_TIME}"
    fi

    # Add per-model contribution to 7-day total as equation: 7d:15% = S:10% (315K) + O:5% (139K)
    # Order: H, S, O
    MODELS_OUTPUT=""
    FIRST_MODEL=true

    if [[ "${HAIKU:-null}" != "null" ]] && [[ "${HAIKU:-0}" != "0" ]]; then
        if [[ "$FIRST_MODEL" == "true" ]]; then
            MODELS_OUTPUT="H${COLON}$(color_usage_synthetic $HAIKU)"
            if [[ $HAIKU_TOKENS -gt 0 ]]; then
                MODELS_OUTPUT="$MODELS_OUTPUT ${DIM}(${RESET}${BRIGHT_BLUE}$(format_tokens $HAIKU_TOKENS)${RESET}${DIM})${RESET}"
            fi
            FIRST_MODEL=false
        else
            MODELS_OUTPUT="$MODELS_OUTPUT ${PLUS} H${COLON}$(color_usage_synthetic $HAIKU)"
            if [[ $HAIKU_TOKENS -gt 0 ]]; then
                MODELS_OUTPUT="$MODELS_OUTPUT ${DIM}(${RESET}${BRIGHT_BLUE}$(format_tokens $HAIKU_TOKENS)${RESET}${DIM})${RESET}"
            fi
        fi
    fi

    if [[ "$SONNET" != "null" ]] && [[ "$SONNET" != "?" ]]; then
        if [[ "$FIRST_MODEL" == "true" ]]; then
            MODELS_OUTPUT="S${COLON}$(color_usage $SONNET)"
            if [[ $SONNET_TOKENS -gt 0 ]]; then
                MODELS_OUTPUT="$MODELS_OUTPUT ${DIM}(${RESET}${BRIGHT_BLUE}$(format_tokens $SONNET_TOKENS)${RESET}${DIM})${RESET}"
            fi
            FIRST_MODEL=false
        else
            MODELS_OUTPUT="$MODELS_OUTPUT ${PLUS} S${COLON}$(color_usage $SONNET)"
            if [[ $SONNET_TOKENS -gt 0 ]]; then
                MODELS_OUTPUT="$MODELS_OUTPUT ${DIM}(${RESET}${BRIGHT_BLUE}$(format_tokens $SONNET_TOKENS)${RESET}${DIM})${RESET}"
            fi
        fi
    fi

    if [[ "$OPUS" != "null" ]] && [[ "$OPUS" != "?" ]] && [[ "$OPUS" != "0" ]]; then
        if [[ "$FIRST_MODEL" == "true" ]]; then
            MODELS_OUTPUT="O${COLON}$(color_usage_synthetic $OPUS)"
            if [[ $OPUS_TOKENS -gt 0 ]]; then
                MODELS_OUTPUT="$MODELS_OUTPUT ${DIM}(${RESET}${BRIGHT_BLUE}$(format_tokens $OPUS_TOKENS)${RESET}${DIM})${RESET}"
            fi
            FIRST_MODEL=false
        else
            MODELS_OUTPUT="$MODELS_OUTPUT ${PLUS} O${COLON}$(color_usage_synthetic $OPUS)"
            if [[ $OPUS_TOKENS -gt 0 ]]; then
                MODELS_OUTPUT="$MODELS_OUTPUT ${DIM}(${RESET}${BRIGHT_BLUE}$(format_tokens $OPUS_TOKENS)${RESET}${DIM})${RESET}"
            fi
        fi
    fi

    # Add the equation to output if we have any models
    if [[ -n "$MODELS_OUTPUT" ]]; then
        OUTPUT="$OUTPUT ${EQUALS} ${MODELS_OUTPUT}"
    fi
fi

# Extract session metadata for cross-machine tracking
SESSION_ID=$(echo "$INPUT" | jq -r '.session_id // ""' 2>/dev/null || echo "")
SESSION_COST=$(echo "$INPUT" | jq -r '.cost.total_cost_usd // 0' 2>/dev/null || echo "0")
SESSION_COST_FORMATTED=$(printf "%.2f" "$SESSION_COST")

# WAL write: Capture session cost locally (instant, no network)
if [[ -n "$SESSION_ID" ]] && command -v claude-session-sync >/dev/null 2>&1; then
    # Check if this is a new session (WAL file didn't exist before)
    WAL_FILE="/tmp/claude-session-wal/$SESSION_ID"
    IS_NEW_SESSION=false
    if [[ ! -f "$WAL_FILE" ]]; then
        IS_NEW_SESSION=true
    fi

    # Write to WAL (every invocation, instant)
    claude-session-sync wal-write "$SESSION_ID" "$SESSION_COST" 2>/dev/null || true

    # Sync check (backgrounded, throttled to every 10s)
    (
        if [[ "$IS_NEW_SESSION" == "true" ]]; then
            # New session: sync previous session's final WAL + prune old data
            claude-session-sync sync 2>/dev/null || true
            claude-session-sync prune 2>/dev/null || true
            claude-session-sync token-sync 2>/dev/null || true
            claude-session-sync token-prune 2>/dev/null || true
        else
            # Existing session: just sync if it's been 10s
            claude-session-sync sync 2>/dev/null || true
            claude-session-sync token-sync 2>/dev/null || true
        fi
    ) &
fi

# Get monthly total from Firebase
MONTHLY_TOTAL=""
if [[ -n "${CLAUDE_FIREBASE_URL:-}" ]] && command -v claude-session-sync >/dev/null 2>&1; then
    # Try Firebase first
    MONTHLY_TOTAL=$(claude-session-sync read --color 2>/dev/null || echo "")
fi

# Fallback chain: Firebase -> stale cache -> "?"
if [[ -z "$MONTHLY_TOTAL" ]]; then
    # Try stale Firebase cache
    if [[ -f "/tmp/claude-session-sync-read" ]]; then
        MONTHLY_TOTAL=$(cat "/tmp/claude-session-sync-read" 2>/dev/null || echo "")
    fi
fi

if [[ -z "$MONTHLY_TOTAL" ]]; then
    # No Firebase data available
    MONTHLY_TOTAL="${LIGHT_PURPLE}?${RESET}"
fi

# Calculate billing cycle days for V: display
BILLING_DAY=$(jq -r '.oauthAccount.subscriptionCreatedAt // ""' ~/.claude.json 2>/dev/null | cut -d- -f3 | cut -dT -f1 || echo "12")
CURRENT_DAY=$(date +%d | sed 's/^0//')
CURRENT_MONTH=$(date +%Y-%m)

# Calculate cycle start and end dates
if [[ $CURRENT_DAY -ge $BILLING_DAY ]]; then
    # We're past billing day this month - cycle started this month
    CYCLE_START="${CURRENT_MONTH}-${BILLING_DAY}"
    # Cycle ends next month on billing day
    if date -v+1m +%Y-%m >/dev/null 2>&1; then
        CYCLE_END=$(date -v+1m +%Y-%m)-${BILLING_DAY}
    else
        CYCLE_END=$(date -d "1 month" +%Y-%m)-${BILLING_DAY}
    fi
else
    # Before billing day - cycle started last month
    if date -v-1m +%Y-%m >/dev/null 2>&1; then
        CYCLE_START=$(date -v-1m +%Y-%m)-${BILLING_DAY}
    else
        CYCLE_START=$(date -d "1 month ago" +%Y-%m)-${BILLING_DAY}
    fi
    CYCLE_END="${CURRENT_MONTH}-${BILLING_DAY}"
fi

# Calculate days elapsed and remaining
CURRENT_TS=$(date +%s)
if date -j -f "%Y-%m-%d" "$CYCLE_START" +%s >/dev/null 2>&1; then
    # BSD date (macOS)
    CYCLE_START_TS=$(date -j -f "%Y-%m-%d" "$CYCLE_START" +%s)
    CYCLE_END_TS=$(date -j -f "%Y-%m-%d" "$CYCLE_END" +%s)
else
    # GNU date (Linux)
    CYCLE_START_TS=$(date -d "$CYCLE_START" +%s)
    CYCLE_END_TS=$(date -d "$CYCLE_END" +%s)
fi

DAYS_ELAPSED=$(( (CURRENT_TS - CYCLE_START_TS) / 86400 ))
DAYS_REMAINING=$(( (CYCLE_END_TS - CURRENT_TS) / 86400 ))

# Display: V:$34.58/$160 | C:+11/-17d (Value: session/monthly | Cycle: days elapsed/remaining)
CYCLE_DAYS="C${COLON}${CYAN}+${DAYS_ELAPSED}${RESET}${DIM}/${RESET}${CYAN}-${DAYS_REMAINING}d${RESET}"
if [[ -n "$OUTPUT" ]]; then
    OUTPUT="$OUTPUT ${SEP} V${COLON}${LIGHT_PURPLE}\$${SESSION_COST_FORMATTED}${RESET}${DIM}/${RESET}${MONTHLY_TOTAL} ${SEP} ${CYCLE_DAYS}"
else
    OUTPUT="V${COLON}${LIGHT_PURPLE}\$${SESSION_COST_FORMATTED}${RESET}${DIM}/${RESET}${MONTHLY_TOTAL} ${SEP} ${CYCLE_DAYS}"
fi

# Add overage if enabled (Billing: used/limit)
if [[ "$EXTRA_ENABLED" == "true" ]]; then
    OUTPUT="$OUTPUT ${SEP} B${COLON}$(color_cost $EXTRA_USED $EXTRA_LIMIT)/${GREEN}\$${EXTRA_LIMIT}${RESET}"
fi

# Add context window percentage (from Claude Code session data)
CONTEXT_PCT=$(echo "$INPUT" | jq -r '.context_window.used_percentage // 0 | round' 2>/dev/null || echo "0")
OUTPUT="$OUTPUT ${SEP} X${COLON}${BRIGHT_CYAN}${CONTEXT_PCT}%${RESET}"

# Add model information
# Model in INPUT is an object with {id, display_name}
MODEL_NAME=$(echo "$INPUT" | jq -r '.model.display_name // .model.id // .model // ""' 2>/dev/null)
MODEL_PLAN=$(jq -r '.model // ""' ~/.claude/settings.json 2>/dev/null)

# Build model display - always show setting/actual to detect drift
MODEL_DISPLAY=""
if [[ -n "$MODEL_NAME" ]] && [[ -n "$MODEL_PLAN" ]] && [[ "$MODEL_PLAN" != "null" ]]; then
    # Always show both to detect drift
    MODEL_DISPLAY="${MODEL_PLAN}/${MODEL_NAME}"
elif [[ -n "$MODEL_NAME" ]]; then
    MODEL_DISPLAY="${MODEL_NAME}"
elif [[ -n "$MODEL_PLAN" ]]; then
    MODEL_DISPLAY="${MODEL_PLAN}"
fi

if [[ -n "$MODEL_DISPLAY" ]]; then
    OUTPUT="$OUTPUT ${SEP} ${MODEL_DISPLAY}"
fi

echo "$OUTPUT"
