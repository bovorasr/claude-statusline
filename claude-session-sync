#!/usr/bin/env bash

# claude-session-sync: Centralized cross-machine session cost tracking via Firebase RTDB
# Architecture: Local WAL (write-ahead log) + periodic sync to Firebase
# - Every statusline invocation: write to local WAL (instant, no network)
# - Every 10s: background sync all WAL files to Firebase
# - On session start: flush previous session's WAL + prune old sessions

set -euo pipefail

WAL_DIR="/tmp/claude-session-wal"
SYNC_TS_FILE="/tmp/claude-session-sync-ts"
READ_CACHE_FILE="/tmp/claude-session-sync-read"
SYNC_INTERVAL=10  # seconds
READ_CACHE_TTL=60  # seconds

TOKEN_SYNC_TS_FILE="/tmp/claude-token-sync-ts"
TOKEN_READ_CACHE_FILE="/tmp/claude-token-read-cache"
TOKEN_READ_CACHE_TTL=60  # seconds

COST_DELTA_DIR="/tmp/claude-cost-delta-pending"
COST_DELTAS_CACHE="/tmp/claude-cost-deltas-cache"
COST_DELTAS_CACHE_TTL=60  # seconds

# Ensure WAL and cost delta directories exist
mkdir -p "$WAL_DIR"
mkdir -p "$COST_DELTA_DIR"

usage() {
    cat <<EOF
Usage: claude-session-sync <command> [args]

Commands:
  wal-write <session_id> <cost>
      Write session data to local WAL file (instant, no network call)

  sync
      Sync all WAL files to Firebase RTDB (backgrounded, throttled to every 10s)

  read [--color]
      Read total monthly session costs from Firebase
      Output format: \$160
      Cached for 60s to stay under bandwidth limits

  prune [--days N]
      Delete sessions older than N days from Firebase (default: 90)
      Called automatically on session start, runs in background

  token-sync
      Sync daily model token stats to Firebase (throttled by stats-cache.json mtime)
      Reads dailyModelTokens from ~/.claude/stats-cache.json for last 8 days

  token-read [--days N]
      Read aggregated model token stats from Firebase (default: 7 days)
      Output format: JSON with model IDs as keys
      Cached for 60s to stay under bandwidth limits

  token-prune [--days N]
      Delete daily token stats older than N days from Firebase (default: 14)

  cost-read --window 5h|7d [--color]
      Sum cost deltas within time window from Firebase cost-deltas
      Output format: \$2.50 (empty if zero)
      Raw data cached for 60s; also includes unsynced local pending deltas

  cost-prune [--days N]
      Delete cost-delta date keys older than N days from Firebase (default: 14)

Environment variables required:
  CLAUDE_FIREBASE_URL     - Firebase RTDB URL (e.g., https://your-db.firebaseio.com)
  CLAUDE_FIREBASE_SECRET  - Firebase auth secret

Examples:
  claude-session-sync wal-write abc123 27.59
  claude-session-sync sync
  claude-session-sync read --color
  claude-session-sync prune --days 90
  claude-session-sync token-sync
  claude-session-sync token-read --days 7
  claude-session-sync token-prune --days 14
  claude-session-sync cost-read --window 5h --color
  claude-session-sync cost-read --window 7d
  claude-session-sync cost-prune --days 14
EOF
    exit 1
}

# Check Firebase credentials
check_credentials() {
    if [[ -z "${CLAUDE_FIREBASE_URL:-}" ]] || [[ -z "${CLAUDE_FIREBASE_SECRET:-}" ]]; then
        echo "Error: CLAUDE_FIREBASE_URL and CLAUDE_FIREBASE_SECRET must be set" >&2
        exit 1
    fi
}

# wal-write: Write session data to local WAL file
cmd_wal_write() {
    local session_id=$1
    local cost=$2

    local wal_file="$WAL_DIR/$session_id"
    local machine=$(hostname -s)
    local ts=$(date +%s)
    local date_str=$(date -u +%Y-%m-%d)

    # Read previous cost from existing WAL to compute delta
    local prev_cost=0
    if [[ -f "$wal_file" ]]; then
        prev_cost=$(jq -r '.cost // 0' "$wal_file" 2>/dev/null || echo "0")
    fi

    # Compute delta; append to pending file if cost increased meaningfully
    local delta
    delta=$(awk "BEGIN {printf \"%.10f\", $cost - $prev_cost}")
    if (( $(awk "BEGIN {print ($delta > 0.001)}") )); then
        local pending_file="$COST_DELTA_DIR/${session_id}.pending"
        local entry="{\"d\":${delta},\"t\":${ts},\"date\":\"${date_str}\",\"m\":\"${machine}\"}"
        echo "$entry" >> "$pending_file"
        # Write last query cost for statusline display (session_id + delta)
        echo "$session_id $delta" > "/tmp/claude-last-query-cost"
    fi

    # Write JSON to WAL file (cumulative cost for /sessions/ path)
    cat > "$wal_file" <<EOF
{
  "cost": $cost,
  "ts": $ts,
  "machine": "$machine"
}
EOF
}

# sync: Sync all WAL files to Firebase
cmd_sync() {
    check_credentials

    # Throttle: only sync if last sync was more than SYNC_INTERVAL seconds ago
    if [[ -f "$SYNC_TS_FILE" ]]; then
        local now=$(date +%s)
        local last_sync
        # BSD stat (macOS) uses -f %m, GNU stat (Linux) uses -c %Y
        if stat -f %m "$SYNC_TS_FILE" >/dev/null 2>&1; then
            last_sync=$(stat -f %m "$SYNC_TS_FILE")
        else
            last_sync=$(stat -c %Y "$SYNC_TS_FILE")
        fi
        local age=$((now - last_sync))

        if [[ $age -lt $SYNC_INTERVAL ]]; then
            # Too soon, skip sync
            return 0
        fi
    fi

    # Sync all WAL files to Firebase
    for wal_file in "$WAL_DIR"/*; do
        if [[ ! -f "$wal_file" ]]; then
            continue
        fi

        local session_id=$(basename "$wal_file")
        local data=$(cat "$wal_file")

        # PUT to Firebase (native upsert, no read-before-write)
        curl -s -X PUT \
            --connect-timeout 2 \
            --max-time 3 \
            -H "Content-Type: application/json" \
            -d "$data" \
            "${CLAUDE_FIREBASE_URL}/sessions/${session_id}.json?auth=${CLAUDE_FIREBASE_SECRET}" \
            >/dev/null 2>&1 || true  # Ignore errors (offline, etc.)
    done

    # Sync cost delta pending files to Firebase via multi-path PATCH
    for pending_file in "$COST_DELTA_DIR"/*.pending; do
        if [[ ! -f "$pending_file" ]]; then
            continue
        fi

        local session_id
        session_id=$(basename "$pending_file" .pending)

        # Read all JSONL entries as an array
        local entries
        entries=$(jq -s '.' "$pending_file" 2>/dev/null || echo "[]")

        # Get unique dates spanned by this session's pending entries
        local dates
        dates=$(echo "$entries" | jq -r '.[].date' 2>/dev/null | sort -u || echo "")

        local session_ok=true
        while IFS= read -r date_key; do
            if [[ -z "$date_key" ]]; then
                continue
            fi

            # Build multi-path PATCH payload for this date
            # Keys use Firebase path format: cost-deltas/{date}/{session}/d/{ts}
            local patch_payload
            patch_payload=$(echo "$entries" | jq -c \
                --arg date "$date_key" \
                --arg session "$session_id" '
                map(select(.date == $date)) |
                if length == 0 then {}
                else
                    reduce .[] as $e (
                        {};
                        . + {("cost-deltas/" + $date + "/" + $session + "/m"): $e.m,
                             ("cost-deltas/" + $date + "/" + $session + "/d/" + ($e.t | tostring)): $e.d}
                    )
                end
            ' 2>/dev/null || echo "{}")

            if [[ "$patch_payload" == "{}" ]]; then
                continue
            fi

            local http_code
            http_code=$(curl -s -o /dev/null -w "%{http_code}" -X PATCH \
                --connect-timeout 2 \
                --max-time 3 \
                -H "Content-Type: application/json" \
                -d "$patch_payload" \
                "${CLAUDE_FIREBASE_URL}/.json?auth=${CLAUDE_FIREBASE_SECRET}" 2>/dev/null || echo "0")

            if [[ "$http_code" != "200" ]]; then
                session_ok=false
            fi
        done <<< "$dates"

        # Delete pending file only if all dates synced successfully
        if [[ "$session_ok" == "true" ]]; then
            rm -f "$pending_file"
        fi
    done

    # Update sync timestamp
    touch "$SYNC_TS_FILE"
}

# read: Read monthly session costs from Firebase
cmd_read() {
    local use_color=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --color)
                use_color=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    # Check cache freshness
    if [[ -f "$READ_CACHE_FILE" ]]; then
        local now=$(date +%s)
        local cache_mtime
        if stat -f %m "$READ_CACHE_FILE" >/dev/null 2>&1; then
            cache_mtime=$(stat -f %m "$READ_CACHE_FILE")
        else
            cache_mtime=$(stat -c %Y "$READ_CACHE_FILE")
        fi
        local cache_age=$((now - cache_mtime))

        if [[ $cache_age -lt $READ_CACHE_TTL ]]; then
            # Cache is fresh, use it
            cat "$READ_CACHE_FILE"
            return 0
        fi
    fi

    check_credentials

    # Fetch all sessions from Firebase
    local sessions=$(curl -s -X GET \
        --connect-timeout 2 \
        --max-time 5 \
        "${CLAUDE_FIREBASE_URL}/sessions.json?auth=${CLAUDE_FIREBASE_SECRET}" 2>/dev/null || echo "{}")

    # Get billing day from ~/.claude.json (same logic as claude-billing-cost)
    local billing_day=$(jq -r '.oauthAccount.subscriptionCreatedAt // ""' ~/.claude.json 2>/dev/null | cut -d- -f3 | cut -dT -f1 || echo "12")

    # Calculate billing cycle start
    local current_day=$(date +%d | sed 's/^0//')
    local current_month=$(date +%Y-%m)

    local cycle_start
    if [[ $current_day -ge $billing_day ]]; then
        cycle_start="${current_month}-${billing_day}"
    else
        cycle_start=$(date -v-1m +%Y-%m)-${billing_day}
    fi

    local cycle_start_ts=$(date -j -f "%Y-%m-%d" "$cycle_start" +%s 2>/dev/null || echo "0")

    # Calculate total cost from all sessions in billing cycle
    local total_cost=$(echo "$sessions" | jq --arg cycle_ts "$cycle_start_ts" '
        to_entries |
        map(select(.value.ts >= ($cycle_ts | tonumber))) |
        map(.value.cost) |
        add // 0
    ' 2>/dev/null || echo "0")

    # Round to nearest dollar
    total_cost=$(printf "%.0f" "$total_cost" 2>/dev/null || echo "0")

    # Format output (just the total)
    local output=""

    if [[ "$use_color" == "true" ]]; then
        local LIGHT_PURPLE=$'\033[38;5;135m'
        local RESET=$'\033[0m'
        output="${LIGHT_PURPLE}\$${total_cost}${RESET}"
    else
        output="\$${total_cost}"
    fi

    # Cache the result
    echo "$output" > "$READ_CACHE_FILE"
    echo "$output"
}

# prune: Delete old sessions from Firebase
cmd_prune() {
    local days=90

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --days)
                days=$2
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    check_credentials

    # Calculate cutoff timestamp
    local cutoff_ts=$(date -v-${days}d +%s 2>/dev/null || date -d "${days} days ago" +%s 2>/dev/null || echo "0")

    # Fetch all sessions from Firebase
    local sessions=$(curl -s -X GET \
        --connect-timeout 2 \
        --max-time 5 \
        "${CLAUDE_FIREBASE_URL}/sessions.json?auth=${CLAUDE_FIREBASE_SECRET}" 2>/dev/null || echo "{}")

    # Find and delete old sessions
    local old_sessions=$(echo "$sessions" | jq -r --arg cutoff "$cutoff_ts" '
        to_entries |
        map(select(.value.ts < ($cutoff | tonumber))) |
        .[].key
    ' 2>/dev/null || echo "")

    if [[ -n "$old_sessions" ]]; then
        while IFS= read -r session_id; do
            if [[ -n "$session_id" ]]; then
                curl -s -X DELETE \
                    --connect-timeout 2 \
                    --max-time 3 \
                    "${CLAUDE_FIREBASE_URL}/sessions/${session_id}.json?auth=${CLAUDE_FIREBASE_SECRET}" \
                    >/dev/null 2>&1 || true
            fi
        done <<< "$old_sessions"
    fi
}

# Format a dollar amount: cents symbol (postfix) for amounts < $1
format_money() {
    local amount=$1
    if (( $(awk "BEGIN {print ($amount < 1.0)}") )); then
        local cents
        cents=$(awk "BEGIN {printf \"%.0f\", $amount * 100}")
        printf "%s¢" "$cents"
    else
        printf "\$%.2f" "$amount"
    fi
}

# cost-read: Read windowed cost from Firebase cost-deltas
cmd_cost_read() {
    local window="5h"
    local use_color=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --window)
                window=$2
                shift 2
                ;;
            --color)
                use_color=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    # Convert window to seconds
    local window_seconds
    case "$window" in
        5h) window_seconds=$((5 * 3600)) ;;
        7d) window_seconds=$((7 * 86400)) ;;
        *)
            echo "Error: Unknown window: $window (use 5h or 7d)" >&2
            exit 1
            ;;
    esac

    local now=$(date +%s)
    local cutoff=$((now - window_seconds))

    # Check raw data cache freshness
    local raw_data="{}"
    if [[ -f "$COST_DELTAS_CACHE" ]]; then
        local cache_mtime
        if stat -f %m "$COST_DELTAS_CACHE" >/dev/null 2>&1; then
            cache_mtime=$(stat -f %m "$COST_DELTAS_CACHE")
        else
            cache_mtime=$(stat -c %Y "$COST_DELTAS_CACHE")
        fi
        local cache_age=$((now - cache_mtime))
        if [[ $cache_age -lt $COST_DELTAS_CACHE_TTL ]]; then
            raw_data=$(cat "$COST_DELTAS_CACHE")
        fi
    fi

    # Fetch fresh data if cache is stale or missing
    if [[ "$raw_data" == "{}" ]] || [[ "$raw_data" == "null" ]]; then
        check_credentials
        raw_data=$(curl -s -X GET \
            --connect-timeout 2 \
            --max-time 5 \
            "${CLAUDE_FIREBASE_URL}/cost-deltas.json?auth=${CLAUDE_FIREBASE_SECRET}" 2>/dev/null || echo "{}")

        # Cache raw data if valid
        if [[ "$raw_data" != "{}" ]] && [[ "$raw_data" != "null" ]] && [[ -n "$raw_data" ]]; then
            echo "$raw_data" > "$COST_DELTAS_CACHE"
        fi
    fi

    # Sum deltas within window from Firebase data
    local firebase_total
    firebase_total=$(echo "$raw_data" | jq --argjson cutoff "$cutoff" '
        if . == null or . == {} then 0
        else
            [to_entries[] |  # dates
             .value | to_entries[] |  # sessions
             .value.d // {} | to_entries[] |  # timestamps
             select((.key | tonumber) >= $cutoff) |
             .value] |
            add // 0
        end
    ' 2>/dev/null || echo "0")

    # Also sum unsynced local pending deltas within window
    local pending_total=0
    for pending_file in "$COST_DELTA_DIR"/*.pending; do
        if [[ ! -f "$pending_file" ]]; then
            continue
        fi
        local file_total
        file_total=$(jq -s --argjson cutoff "$cutoff" '
            map(select(.t >= $cutoff)) |
            map(.d) |
            add // 0
        ' "$pending_file" 2>/dev/null || echo "0")
        pending_total=$(awk "BEGIN {printf \"%.10f\", $pending_total + $file_total}")
    done

    local total
    total=$(awk "BEGIN {printf \"%.2f\", $firebase_total + $pending_total}")

    # Return empty if zero (no need to show "$0.00" in statusline)
    if (( $(awk "BEGIN {print ($total < 0.001)}") )); then
        return 0
    fi

    # Format output
    local formatted
    formatted=$(format_money "$total")
    if [[ "$use_color" == "true" ]]; then
        local LIGHT_PURPLE=$'\033[38;5;135m'
        local RESET=$'\033[0m'
        echo "${LIGHT_PURPLE}${formatted}${RESET}"
    else
        echo "$formatted"
    fi
}

# cost-prune: Delete old cost-delta date keys from Firebase
cmd_cost_prune() {
    local days=14

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --days)
                days=$2
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    check_credentials

    # Calculate cutoff date
    local cutoff_date
    if date -v-${days}d +%Y-%m-%d >/dev/null 2>&1; then
        cutoff_date=$(date -v-${days}d +%Y-%m-%d)
    else
        cutoff_date=$(date -d "${days} days ago" +%Y-%m-%d)
    fi

    # Fetch shallow key list from Firebase (keys only, no data)
    local date_keys
    date_keys=$(curl -s -X GET \
        --connect-timeout 2 \
        --max-time 5 \
        "${CLAUDE_FIREBASE_URL}/cost-deltas.json?auth=${CLAUDE_FIREBASE_SECRET}&shallow=true" 2>/dev/null || echo "{}")

    # Find dates older than cutoff
    local old_dates
    old_dates=$(echo "$date_keys" | jq -r --arg cutoff "$cutoff_date" '
        to_entries |
        map(select(.key < $cutoff)) |
        .[].key
    ' 2>/dev/null || echo "")

    if [[ -n "$old_dates" ]]; then
        while IFS= read -r date; do
            if [[ -n "$date" ]]; then
                curl -s -X DELETE \
                    --connect-timeout 2 \
                    --max-time 3 \
                    "${CLAUDE_FIREBASE_URL}/cost-deltas/${date}.json?auth=${CLAUDE_FIREBASE_SECRET}" \
                    >/dev/null 2>&1 || true
            fi
        done <<< "$old_dates"
    fi
}

# token-sync: Sync daily model token stats to Firebase
cmd_token_sync() {
    check_credentials

    local stats_file="$HOME/.claude/stats-cache.json"
    if [[ ! -f "$stats_file" ]]; then
        # No stats file, nothing to sync
        return 0
    fi

    # Check if stats-cache.json has changed since last sync
    local stats_mtime
    if stat -f %m "$stats_file" >/dev/null 2>&1; then
        stats_mtime=$(stat -f %m "$stats_file")
    else
        stats_mtime=$(stat -c %Y "$stats_file")
    fi

    if [[ -f "$TOKEN_SYNC_TS_FILE" ]]; then
        local last_sync_mtime
        if stat -f %m "$TOKEN_SYNC_TS_FILE" >/dev/null 2>&1; then
            last_sync_mtime=$(stat -f %m "$TOKEN_SYNC_TS_FILE")
        else
            last_sync_mtime=$(stat -c %Y "$TOKEN_SYNC_TS_FILE")
        fi

        if [[ $stats_mtime -le $last_sync_mtime ]]; then
            # Stats haven't changed since last sync
            return 0
        fi
    fi

    # Get machine name for namespacing
    local machine=$(hostname -s)

    # Calculate cutoff date (8 days ago to cover 7-day window + timezone buffer)
    local cutoff_date
    if date -v-8d +%Y-%m-%d >/dev/null 2>&1; then
        cutoff_date=$(date -v-8d +%Y-%m-%d)
    else
        cutoff_date=$(date -d "8 days ago" +%Y-%m-%d)
    fi

    # Extract dailyModelTokens from stats-cache.json (it's an array)
    local daily_entries=$(jq -c --arg cutoff "$cutoff_date" '
        .dailyModelTokens // [] |
        map(select(.date >= $cutoff))
    ' "$stats_file" 2>/dev/null || echo "[]")

    if [[ "$daily_entries" == "[]" ]]; then
        # No entries to sync
        return 0
    fi

    # Sync each day's data to Firebase
    echo "$daily_entries" | jq -c '.[]' | while IFS= read -r entry; do
        if [[ -z "$entry" ]]; then
            continue
        fi

        local date_str=$(echo "$entry" | jq -r '.date')
        local tokens_by_model=$(echo "$entry" | jq -c '.tokensByModel // {}')

        # PUT to Firebase: /daily-tokens/{date}/{machine}.json
        curl -s -X PUT \
            --connect-timeout 2 \
            --max-time 3 \
            -H "Content-Type: application/json" \
            -d "$tokens_by_model" \
            "${CLAUDE_FIREBASE_URL}/daily-tokens/${date_str}/${machine}.json?auth=${CLAUDE_FIREBASE_SECRET}" \
            >/dev/null 2>&1 || true
    done

    # Update sync timestamp
    touch "$TOKEN_SYNC_TS_FILE"
}

# token-read: Read aggregated model token stats from Firebase
cmd_token_read() {
    local days=7

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --days)
                days=$2
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    # Check cache freshness
    if [[ -f "$TOKEN_READ_CACHE_FILE" ]]; then
        local now=$(date +%s)
        local cache_mtime
        if stat -f %m "$TOKEN_READ_CACHE_FILE" >/dev/null 2>&1; then
            cache_mtime=$(stat -f %m "$TOKEN_READ_CACHE_FILE")
        else
            cache_mtime=$(stat -c %Y "$TOKEN_READ_CACHE_FILE")
        fi
        local cache_age=$((now - cache_mtime))

        if [[ $cache_age -lt $TOKEN_READ_CACHE_TTL ]]; then
            # Cache is fresh, use it
            cat "$TOKEN_READ_CACHE_FILE"
            return 0
        fi
    fi

    check_credentials

    # Calculate cutoff date
    local cutoff_date
    if date -v-${days}d +%Y-%m-%d >/dev/null 2>&1; then
        cutoff_date=$(date -v-${days}d +%Y-%m-%d)
    else
        cutoff_date=$(date -d "${days} days ago" +%Y-%m-%d)
    fi

    # Fetch all daily token data from Firebase
    local daily_tokens=$(curl -s -X GET \
        --connect-timeout 2 \
        --max-time 5 \
        "${CLAUDE_FIREBASE_URL}/daily-tokens.json?auth=${CLAUDE_FIREBASE_SECRET}" 2>/dev/null || echo "{}")

    # Aggregate tokens across all machines for dates >= cutoff
    local aggregated=$(echo "$daily_tokens" | jq --arg cutoff "$cutoff_date" '
        to_entries |
        map(select(.key >= $cutoff)) |
        map(.value | to_entries | .[]) |
        reduce .[] as $machine ({}; . as $acc | $machine.value | to_entries | reduce .[] as $model ($acc; .[$model.key] += $model.value))
    ' 2>/dev/null || echo "{}")

    # Cache the result
    echo "$aggregated" > "$TOKEN_READ_CACHE_FILE"
    echo "$aggregated"
}

# token-prune: Delete old daily token stats from Firebase
cmd_token_prune() {
    local days=14

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --days)
                days=$2
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    check_credentials

    # Calculate cutoff date
    local cutoff_date
    if date -v-${days}d +%Y-%m-%d >/dev/null 2>&1; then
        cutoff_date=$(date -v-${days}d +%Y-%m-%d)
    else
        cutoff_date=$(date -d "${days} days ago" +%Y-%m-%d)
    fi

    # Fetch all daily token data from Firebase
    local daily_tokens=$(curl -s -X GET \
        --connect-timeout 2 \
        --max-time 5 \
        "${CLAUDE_FIREBASE_URL}/daily-tokens.json?auth=${CLAUDE_FIREBASE_SECRET}" 2>/dev/null || echo "{}")

    # Find dates older than cutoff
    local old_dates=$(echo "$daily_tokens" | jq -r --arg cutoff "$cutoff_date" '
        to_entries |
        map(select(.key < $cutoff)) |
        .[].key
    ' 2>/dev/null || echo "")

    if [[ -n "$old_dates" ]]; then
        while IFS= read -r date; do
            if [[ -n "$date" ]]; then
                curl -s -X DELETE \
                    --connect-timeout 2 \
                    --max-time 3 \
                    "${CLAUDE_FIREBASE_URL}/daily-tokens/${date}.json?auth=${CLAUDE_FIREBASE_SECRET}" \
                    >/dev/null 2>&1 || true
            fi
        done <<< "$old_dates"
    fi
}

# Main command dispatcher
if [[ $# -lt 1 ]]; then
    usage
fi

COMMAND=$1
shift

case "$COMMAND" in
    wal-write)
        if [[ $# -ne 2 ]]; then
            echo "Error: wal-write requires 2 arguments: <session_id> <cost>" >&2
            exit 1
        fi
        cmd_wal_write "$1" "$2"
        ;;
    sync)
        cmd_sync
        ;;
    read)
        cmd_read "$@"
        ;;
    prune)
        cmd_prune "$@"
        ;;
    token-sync)
        cmd_token_sync
        ;;
    token-read)
        cmd_token_read "$@"
        ;;
